#!/usr/bin/env nix-shell
#! nix-shell -p curl jq coreutils -i bash
# shellcheck shell=bash
set -euo pipefail

# Script to update the sources.json file with the latest Tilt releases

# Default to latest if not specified
RELEASE_TYPE=${1:-latest}
TILT_REPO=${TILT_REPO:-tilt-dev/tilt}

if [[ ! "$TILT_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  echo "Error: TILT_REPO must use the owner/repository form" >&2
  exit 1
fi
if [[ "$RELEASE_TYPE" != "latest" && ! "$RELEASE_TYPE" =~ ^[0-9A-Za-z.+-]+$ ]]; then
  echo "Error: release version contains unsupported characters" >&2
  exit 1
fi

# GitHub API endpoint for releases
if [[ "$RELEASE_TYPE" == "latest" ]]; then
  RELEASES_URL="https://api.github.com/repos/$TILT_REPO/releases/latest"
else
  # For specific versions, use the provided version
  RELEASES_URL="https://api.github.com/repos/$TILT_REPO/releases/tags/v$RELEASE_TYPE"
fi

# The upstream release publishes all supported platforms. Fork releases can
# select their deliberately smaller artifact matrix with a space-delimited
# TILT_PLATFORMS value.
if [[ -n "${TILT_PLATFORMS:-}" ]]; then
  read -r -a PLATFORMS <<<"$TILT_PLATFORMS"
else
  PLATFORMS=(
    "aarch64-darwin"
    "aarch64-linux"
    "x86_64-darwin"
    "x86_64-linux"
  )
fi
if (("${#PLATFORMS[@]}" == 0)); then
  echo "Error: at least one platform is required" >&2
  exit 1
fi

# Mapping from our platform names to Tilt's archive naming
get_platform_name() {
  local platform=$1
  case "$platform" in
  "aarch64-darwin") echo "mac.arm64" ;;
  "aarch64-linux") echo "linux.arm64" ;;
  "x86_64-darwin") echo "mac.x86_64" ;;
  "x86_64-linux") echo "linux.x86_64" ;;
  *)
    echo "Error: unsupported platform '$platform'" >&2
    return 1
    ;;
  esac
}

# Check required tools
for cmd in awk curl jq nix-hash sha256sum; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "Error: Required command '$cmd' not found"
    exit 1
  fi
done

# Get release info from GitHub
echo "Fetching $RELEASE_TYPE release information from $TILT_REPO..."
RELEASE_INFO=$(curl -fsSL "$RELEASES_URL")

# Get version/tag info
TAG=$(echo "$RELEASE_INFO" | jq -r '.tag_name')
if [[ "$TAG" == "null" ]]; then
  echo "Error: Could not get tag information"
  exit 1
fi

# Extract the version number (remove 'v' prefix)
VERSION="${TAG#v}"

echo "Processing $RELEASE_TYPE release: $TAG (version: $VERSION)"

# The base URL for downloading the archives
BASE_URL="https://github.com/$TILT_REPO/releases/download/$TAG"

# Download and verify checksums
echo "Downloading checksums.txt..."
CHECKSUMS_URL="$BASE_URL/checksums.txt"
CHECKSUMS=$(curl -fsSL "$CHECKSUMS_URL")

# Create a temporary file for our updated JSON
TMP_JSON=$(mktemp)
archive_file=""

cleanup() {
  rm -f "$TMP_JSON" "$archive_file" sources.json.new
}
trap cleanup EXIT

platforms_json="{}"

# Create JSON objects for each platform
for platform in "${PLATFORMS[@]}"; do
  platform_name=$(get_platform_name "$platform")
  archive_name="tilt.$VERSION.$platform_name.tar.gz"
  url="$BASE_URL/$archive_name"

  echo "Processing: $platform ($archive_name)..."

  # Get expected SHA256 from checksums.txt
  expected_sha256=$(awk -v archive="$archive_name" '$2 == archive {print $1; exit}' <<<"$CHECKSUMS")
  if [[ -z "$expected_sha256" ]]; then
    echo "Error: Could not find checksum for $archive_name"
    exit 1
  fi

  # Download and verify checksum
  echo "Downloading: $url"
  archive_file=$(mktemp)
  curl -fsSL -o "$archive_file" "$url"

  # Compute actual SHA256 and verify against expected
  actual_sha256=$(sha256sum "$archive_file" | awk '{print $1}')
  if [[ "$actual_sha256" != "$expected_sha256" ]]; then
    rm -f "$archive_file"
    echo "Error: Checksum mismatch for $archive_name"
    echo "  Expected: $expected_sha256"
    echo "  Actual:   $actual_sha256"
    exit 1
  fi
  echo "Checksum verified for $platform"

  # Compute nix hash from verified file
  hash=$(nix-hash --type sha256 --flat --base32 "$archive_file")
  rm -f "$archive_file"
  archive_file=""

  platforms_json=$(
    jq \
      --arg platform "$platform" \
      --arg url "$url" \
      --arg hash "$hash" \
      '. + {($platform): {"url": $url, "sha256": $hash}}' \
      <<<"$platforms_json"
  )
done

# Build our JSON
# For latest release, update both "latest" and the version-specific key
if [[ "$RELEASE_TYPE" == "latest" ]]; then
  jq -n \
    --arg version "$VERSION" \
    --arg tag "$TAG" \
    --argjson platforms "$platforms_json" \
    '{
      "latest": {
        "version": $version,
        "tag": $tag,
        "platforms": $platforms
      },
      ($version): {
        "version": $version,
        "tag": $tag,
        "platforms": $platforms
      }
    }' >"$TMP_JSON"
else
  jq -n \
    --arg version "$VERSION" \
    --arg tag "$TAG" \
    --argjson platforms "$platforms_json" \
    '{
      ($version): {
        "version": $version,
        "tag": $tag,
        "platforms": $platforms
      }
    }' >"$TMP_JSON"
fi

# Check if we need to merge with existing sources.json or create a new one
if [[ -f sources.json ]]; then
  echo "Merging with existing sources.json..."

  # Merge the new JSON with the existing one
  jq -s '.[0] * .[1]' sources.json "$TMP_JSON" >sources.json.new
  mv sources.json.new sources.json
else
  echo "Creating new sources.json..."
  mv "$TMP_JSON" sources.json
fi

echo "Update completed successfully!"
echo "Updated $RELEASE_TYPE to version $VERSION in sources.json"
